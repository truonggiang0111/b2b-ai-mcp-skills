      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const notices = $input.all().map(i => i.json);\nreturn notices.map(n => ({\n  json: {\n    title: n.title,\n    stage: n.stage,\n    buyerName: n.buyerName,\n    contactName: n.contactName,\n    contactEmail: n.contactEmail,\n    valueGBP: n.valueGBP,\n    deadlineDate: n.deadlineDate,\n    suitableForSME: n.suitableForSME,\n    noticeUrl: n.noticeUrl,\n    agentSummary: n.agentSummary\n  }\n}));"
      },
      "id": "format-tender-leads",
